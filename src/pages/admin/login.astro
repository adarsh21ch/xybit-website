---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Admin Login — Xybit">
  <div class="min-h-screen flex items-center justify-center px-5">
    <div class="w-full max-w-[380px]">
      <div class="flex items-center gap-2.5 justify-center mb-8">
        <span class="w-8 h-8 rounded-full border border-dashed border-ink-faint/60 flex items-center justify-center text-[9px] font-mono text-ink-faint">logo</span>
        <span class="font-display font-extrabold text-lg">XYBIT</span>
        <span class="font-mono text-[11px] text-ink-faint border border-border rounded px-1.5 py-0.5">admin</span>
      </div>

      <form id="login-form" class="bg-surface border border-border rounded-2xl p-6 flex flex-col gap-4">
        <div>
          <label class="block font-mono text-[11px] uppercase tracking-wide text-ink-faint mb-1.5" for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="username"
            class="w-full bg-surface-2 border border-border rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:border-accent" />
        </div>
        <div>
          <label class="block font-mono text-[11px] uppercase tracking-wide text-ink-faint mb-1.5" for="password">Password</label>
          <input id="password" name="password" type="password" required autocomplete="current-password"
            class="w-full bg-surface-2 border border-border rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:border-accent" />
        </div>
        <p id="login-error" class="hidden text-[13px] text-[#e08165]"></p>
        <button type="submit" id="login-submit"
          class="mt-1 bg-accent text-[#0a0500] font-display font-bold text-sm py-3 rounded-lg hover:bg-[#ff7f4a] transition-colors disabled:opacity-60">
          Log in
        </button>
      </form>
      <p class="text-center text-[12.5px] text-ink-faint mt-5">
        No account yet? Create one in the Supabase dashboard under Authentication — see the README.
      </p>
    </div>
  </div>

  <script>
    import { supabase, SUPABASE_CONFIGURED } from "../../lib/supabase";

    const form = document.getElementById("login-form") as HTMLFormElement;
    const errorEl = document.getElementById("login-error") as HTMLElement;
    const submitBtn = document.getElementById("login-submit") as HTMLButtonElement;

    // If already logged in, skip straight to the dashboard.
    if (SUPABASE_CONFIGURED) {
      supabase.auth.getSession().then(({ data }) => {
        if (data.session) window.location.href = "/admin/dashboard";
      });
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.classList.add("hidden");

      if (!SUPABASE_CONFIGURED) {
        errorEl.textContent = "Supabase isn't connected yet. Add PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY first.";
        errorEl.classList.remove("hidden");
        return;
      }

      const email = (document.getElementById("email") as HTMLInputElement).value;
      const password = (document.getElementById("password") as HTMLInputElement).value;

      submitBtn.disabled = true;
      submitBtn.textContent = "Logging in…";

      const { error } = await supabase.auth.signInWithPassword({ email, password });

      if (error) {
        errorEl.textContent = error.message;
        errorEl.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = "Log in";
        return;
      }
      window.location.href = "/admin/dashboard";
    });
  </script>
</Layout>
