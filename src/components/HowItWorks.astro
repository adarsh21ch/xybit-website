---
// Redemption steps — how to use the coupon. Deliberately not the trading
// evaluation process; that lives on the main site.
const steps = [
  { n: "01", title: "Copy the code", body: "One tap on the code above puts it on your clipboard." },
  { n: "02", title: "Pick your account", body: "Head to xybitfunds.com and choose the account size you want." },
  { n: "03", title: "Paste at checkout", body: "Drop the code into the discount field before you pay. The discount comes off the total." },
];
---

<section id="how" class="relative py-16 md:py-24 border-t border-border">
  <div class="max-w-[900px] mx-auto px-5 sm:px-7">
    <div class="reveal text-center mb-12">
      <div class="font-mono text-[11.5px] tracking-widest uppercase text-ink-faint mb-3">How to redeem</div>
      <h2 class="text-[26px] md:text-[34px] leading-[1.1]">Three taps and it's applied.</h2>
    </div>

    <div class="relative">
      <div class="hidden md:block absolute left-[8%] right-[8%] top-[26px] h-px bg-gradient-to-r from-transparent via-accent/35 to-transparent -z-10" aria-hidden="true"></div>
      <div class="md:hidden absolute left-[26px] top-8 bottom-8 w-px bg-gradient-to-b from-accent/45 via-accent/20 to-transparent -z-10" aria-hidden="true"></div>

      <ol class="grid md:grid-cols-3 gap-9 md:gap-8 list-none p-0 m-0">
        {steps.map((s, i) => (
          <li class="reveal flex md:flex-col md:items-center md:text-center gap-5 md:gap-0" style={`transition-delay: ${i * 110}ms`}>
            <div class="flex-none w-[52px] h-[52px] rounded-full bg-[#0d0d0d] border border-accent/40 flex items-center justify-center font-mono font-bold text-accent text-[15px] shadow-[0_0_0_8px_#050505]">
              {s.n}
            </div>
            <div class="md:mt-6">
              <h3 class="text-[18px] mb-2">{s.title}</h3>
              <p class="text-ink-soft text-[14.5px] leading-relaxed max-w-[32ch] md:mx-auto">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
