---
import CouponCode from "./CouponCode.astro";
import { DEFAULT_SETTINGS } from "../lib/settings";

const steps = [
  { n: "01", title: "Copy the code", body: "One tap on the code puts it straight on your clipboard." },
  { n: "02", title: "Pick your account", body: "Head to xybitfunds.com and choose the account size you want to trade." },
  { n: "03", title: "Paste at checkout", body: "Drop it into the discount field before you pay. The discount comes off the total." },
];
---

<section id="redeem" class="relative py-20 md:py-28 border-t border-border overflow-hidden">
  <div class="max-w-[1280px] mx-auto px-5 sm:px-7">
    <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-12 lg:gap-20 items-center">
      <div class="reveal">
        <div class="font-mono text-[11.5px] tracking-[0.18em] uppercase text-accent mb-4">How to redeem</div>
        <h2 class="text-[clamp(28px,5vw,48px)] leading-[1.04] mb-5">
          Three taps and<br class="hidden lg:block" /> it's <span class="grad-text">applied</span>.
        </h2>
        <p class="text-ink-soft text-[15.5px] md:text-[17px] leading-relaxed max-w-[40ch] mb-8">
          The code works on any account size. Nothing to sign up for here — the discount is
          applied on the Xybit checkout itself.
        </p>

        <div class="max-w-[400px]">
          <CouponCode />
          <a
            data-cta-redirect
            data-external="true"
            data-copy-on-click
            href={DEFAULT_SETTINGS.redirect_url}
            target="_blank"
            rel="noopener"
            class="group mt-3 w-full inline-flex items-center justify-center gap-2 border border-accent/40 text-accent font-display font-bold text-[15px] px-6 py-3.5 rounded-xl hover:bg-accent/10 transition-colors"
          >
            Go to checkout
            <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <ol class="list-none p-0 m-0 flex flex-col gap-3">
        {steps.map((s, i) => (
          <li
            class="reveal glass rounded-2xl p-5 md:p-7 flex gap-5 items-start hover:-translate-y-1 transition-transform"
            style={`transition-delay: ${i * 100}ms`}
          >
            <span class="flex-none w-12 h-12 md:w-14 md:h-14 rounded-xl bg-gradient-to-br from-accent/25 to-violet/15 border border-accent/30 flex items-center justify-center font-mono font-bold text-accent text-[15px] md:text-[17px]">
              {s.n}
            </span>
            <div class="pt-1">
              <h3 class="text-[18px] md:text-[21px] mb-1.5">{s.title}</h3>
              <p class="text-ink-soft text-[14.5px] md:text-[15.5px] leading-relaxed">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
