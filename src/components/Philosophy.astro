---
// One brand moment so the page isn't purely transactional. This is Xybit's
// own line from the trading-psychology series — no claims, no numbers.
---

<section class="relative py-16 md:py-20 border-t border-border overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="aurora absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[560px] h-[320px] rounded-full bg-accent/10 blur-[130px]"></div>
  </div>

  <div class="max-w-[720px] mx-auto px-5 sm:px-7 text-center">
    <svg aria-hidden="true" class="reveal mx-auto mb-5 text-accent/25" width="40" height="31" viewBox="0 0 52 40" fill="currentColor">
      <path d="M0 40V21.7C0 9.9 6.6 2.6 19.3 0l2.4 6.5c-7.4 2-11.1 6-11.4 12.2H21V40H0Zm31 0V21.7C31 9.9 37.6 2.6 50.3 0l2.4 6.5c-7.4 2-11.1 6-11.4 12.2H52V40H31Z"/>
    </svg>

    <blockquote class="reveal font-display font-bold text-[clamp(20px,4vw,30px)] leading-[1.25] tracking-[-0.015em]">
      You don't get paid for the trades you take.
      <span class="text-ink-faint">You get paid for the ones you skip.</span>
    </blockquote>

    <div class="reveal mt-5 font-mono text-[11.5px] text-ink-faint">— Xybit</div>
  </div>
</section>
