---
import Logo from "./Logo.astro";
---

<footer class="border-t border-border py-10 mb-24 md:mb-0">
  <div class="max-w-[720px] mx-auto px-5 sm:px-7 text-center">
    <a href="#top" class="inline-flex items-center gap-2.5 mb-4">
      <Logo size={26} />
      <span class="font-display font-extrabold text-base">XYBIT</span>
    </a>

    <p class="text-[12px] text-ink-faint leading-relaxed max-w-[52ch] mx-auto mb-5">
      Simulated capital. Trading involves risk and you can lose the fees you pay. This page
      exists to share a discount code — accounts, rules and payments are handled on
      xybitfunds.com.
    </p>

    <div class="flex items-center justify-center gap-5 text-[12.5px] text-ink-faint">
      <a data-cta-redirect data-external="true" href="/" class="hover:text-ink transition-colors">Main site</a>
      <span class="w-px h-3 bg-border"></span>
      <a href="/" class="hover:text-ink transition-colors">Terms</a>
      <span class="w-px h-3 bg-border"></span>
      <a href="/" class="hover:text-ink transition-colors">Privacy</a>
    </div>
  </div>
</footer>
