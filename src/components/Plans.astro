---
import { DEFAULT_SETTINGS } from "../lib/settings";

// Base ("was") prices are structural per tier; the live discount % from the
// admin dashboard is what moves. Rendered against the default discount so
// prices are correct on first paint with no JS.
const plans = [
  { size: "10K", capital: "$10,000", was: 99, split: "80%", featured: false },
  { size: "25K", capital: "$25,000", was: 199, split: "85%", featured: true },
  { size: "50K", capital: "$50,000", was: 349, split: "85%", featured: false },
  { size: "100K", capital: "$100,000", was: 549, split: "90%", featured: false },
].map((p) => ({
  ...p,
  now: Math.round(p.was * (1 - DEFAULT_SETTINGS.discount_percent / 100)),
}));
---

<section id="accounts" class="relative py-20 md:py-28">
  <div class="max-w-[1160px] mx-auto px-5 sm:px-7">
    <div class="reveal flex flex-col md:flex-row md:items-end md:justify-between gap-5 mb-12">
      <div class="max-w-[46ch]">
        <div class="font-mono text-[11.5px] tracking-widest uppercase text-ink-faint mb-3">Accounts</div>
        <h2 class="text-[30px] md:text-[40px] leading-[1.1]">Pick your account size</h2>
      </div>
      <p id="plans-sub" class="text-ink-soft text-[15px] md:text-right md:max-w-[28ch]">
        One evaluation model, four sizes. <span class="text-accent font-semibold">{DEFAULT_SETTINGS.discount_percent}% off</span> every one of them.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-3.5 lg:items-center">
      {plans.map((p, i) => (
        <div
          class:list={[
            "reveal group relative flex flex-col gap-5 rounded-2xl border p-6 hover:-translate-y-1.5 active:scale-[0.99]",
            p.featured
              ? "border-accent/70 bg-gradient-to-b from-accent-bg to-surface lg:py-9 shadow-[0_24px_60px_-30px_rgba(255,106,46,.55)]"
              : "border-border bg-surface hover:border-ink-faint/70",
          ]}
          style={`transition-delay: ${i * 70}ms`}
        >
          {p.featured && (
            <span class="absolute -top-[11px] left-6 bg-accent text-[#0a0500] font-mono text-[10.5px] font-bold tracking-wide px-2.5 py-0.5 rounded">
              Most popular
            </span>
          )}

          <div>
            <div class="font-display font-extrabold text-[22px] tracking-tight">{p.size}</div>
            <div class="font-mono text-[12px] text-ink-faint mt-0.5">{p.capital} simulated</div>
          </div>

          <div class="flex items-baseline gap-2.5">
            <span class="font-display font-extrabold text-[34px] plan-now" data-was={p.was}>${p.now}</span>
            <span class="font-mono text-[13px] text-ink-faint line-through decoration-ink-faint/70">${p.was}</span>
          </div>

          <ul class="flex flex-col gap-3 text-[13.5px] text-ink-soft">
            {["2 trades / day max", "8% profit target", `${p.split} profit split`, "No time limit"].map((f) => (
              <li class="flex items-start gap-2.5">
                <svg class="flex-none mt-0.5 text-accent" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5"/></svg>
                {f}
              </li>
            ))}
          </ul>

          <a
            data-cta-redirect
            data-external="true"
            href="#"
            class:list={[
              "mt-auto text-center font-display font-bold text-[14.5px] px-4 py-3.5 rounded-xl transition-all",
              p.featured
                ? "bg-accent text-[#0a0500] hover:bg-[#ff7f4a] hover:shadow-[0_12px_28px_-10px_rgba(255,106,46,.8)]"
                : "border border-border text-ink hover:border-accent/60 hover:text-accent",
            ]}
          >
            Start Evaluation
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { getSettings } from "../lib/settings-client";

  getSettings().then((s) => {
    document.querySelectorAll<HTMLElement>(".plan-now").forEach((el) => {
      const was = Number(el.dataset.was);
      el.textContent = `$${Math.round(was * (1 - s.discount_percent / 100))}`;
    });
    const sub = document.getElementById("plans-sub");
    if (sub) {
      sub.innerHTML = `One evaluation model, four sizes. <span class="text-accent font-semibold">${s.discount_percent}% off</span> every one of them.`;
    }
    document.querySelectorAll<HTMLAnchorElement>("[data-cta-redirect][data-external='true']").forEach((a) => {
      a.href = s.redirect_url;
    });
  });
</script>
