---
import { DEFAULT_SETTINGS } from "../lib/settings";
import CouponCode from "./CouponCode.astro";

// Mobile gets a persistent offer bar rather than section navigation —
// on a one-job page, the code and the CTA are the only things worth
// keeping permanently within thumb reach.
---

<div
  id="sticky-offer"
  class="md:hidden fixed bottom-0 inset-x-0 z-30 bg-[#0a0a0a]/95 backdrop-blur-md border-t border-border px-4 pt-3 pb-safe translate-y-full transition-transform duration-300"
>
  <div class="flex items-center gap-2.5">
    <div class="flex-1 min-w-0">
      <CouponCode size="sm" />
    </div>
    <a
      data-cta-redirect
      data-external="true"
      data-copy-on-click
      href={DEFAULT_SETTINGS.redirect_url}
      target="_blank"
      rel="noopener"
      class="flex-none inline-flex items-center gap-1.5 bg-accent text-[#0a0500] font-display font-bold text-[13.5px] px-4 py-3 rounded-lg active:scale-95 transition-transform"
    >
      Claim
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>

<script>
  // Slide the bar in only once the hero's own CTA has scrolled away, so it
  // never covers the primary call to action it duplicates.
  const bar = document.getElementById("sticky-offer");
  const hero = document.getElementById("top");
  if (bar && hero) {
    const io = new IntersectionObserver(
      ([entry]) => {
        bar.classList.toggle("translate-y-full", entry.isIntersecting);
      },
      { threshold: 0.15 },
    );
    io.observe(hero);
  }
</script>
