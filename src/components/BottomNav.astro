---
import Logo from "./Logo.astro";
---

<nav
  class="md:hidden fixed bottom-0 inset-x-0 z-30 bg-[#0a0a0a]/90 backdrop-blur-md border-t border-border pb-safe"
  aria-label="Primary"
>
  <div class="grid grid-cols-5 items-end px-2 pt-2">
    <a href="#top" class="flex flex-col items-center gap-1 py-1.5 text-ink-faint hover:text-ink-soft">
      <Logo size={20} />
      <span class="text-[10px] font-mono">Home</span>
    </a>
    <a href="#accounts" class="flex flex-col items-center gap-1 py-1.5 text-ink-faint hover:text-ink-soft">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
      <span class="text-[10px] font-mono">Accounts</span>
    </a>
    <a
      data-cta-redirect
      data-external="true"
      href="#accounts"
      class="flex flex-col items-center -mt-6"
      aria-label="Get Funded"
    >
      <span class="w-14 h-14 rounded-full bg-accent text-[#0a0500] flex items-center justify-center shadow-[0_8px_24px_-6px_rgba(255,106,46,.6)] border-4 border-[#0a0a0a]">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M13 2 3 14h8l-1 8 10-12h-8l1-8Z"/></svg>
      </span>
      <span class="text-[10px] font-mono text-accent mt-1">Get Funded</span>
    </a>
    <a href="#payouts" class="flex flex-col items-center gap-1 py-1.5 text-ink-faint hover:text-ink-soft">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 17 9 11l4 4 8-8"/><path d="M15 7h6v6"/></svg>
      <span class="text-[10px] font-mono">Payouts</span>
    </a>
    <a href="#faq" class="flex flex-col items-center gap-1 py-1.5 text-ink-faint hover:text-ink-soft">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.9.4-1.5 1-1.5 2.2"/><path d="M12 17h.01"/></svg>
      <span class="text-[10px] font-mono">FAQ</span>
    </a>
  </div>
</nav>

<script>
  import { getSettings } from "../lib/settings-client";

  getSettings().then((s) => {
    document.querySelectorAll<HTMLAnchorElement>("[data-cta-redirect][data-external='true']").forEach((a) => {
      a.href = s.redirect_url;
    });
  });
</script>
