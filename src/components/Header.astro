---
import Logo from "./Logo.astro";
import { DEFAULT_SETTINGS } from "../lib/settings";

// No section nav — there's nowhere to navigate on a one-job page. Just the
// mark and the way out to the checkout.
---

<nav class="sticky top-0 z-30 bg-[#050505]/85 backdrop-blur-md border-b border-border">
  <div class="max-w-[1160px] mx-auto px-5 sm:px-7 h-16 flex items-center justify-between">
    <a href="#top" class="flex items-center gap-2.5">
      <Logo size={30} />
      <span class="font-display font-extrabold text-lg tracking-tight">XYBIT</span>
    </a>

    <a
      data-cta-redirect
      data-external="true"
      data-copy-on-click
      href={DEFAULT_SETTINGS.redirect_url}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-1.5 border border-border text-ink font-display font-bold text-[13.5px] px-4 py-2.5 rounded-lg hover:border-accent/60 hover:text-accent transition-colors"
    >
      xybitfunds.com
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</nav>
