---
import Logo from "./Logo.astro";
import { DEFAULT_SETTINGS } from "../lib/settings";
---

<div class="fixed top-0 inset-x-0 z-40 px-4 pt-4 md:pt-5">
  <nav
    id="pill-nav"
    class="glass rim mx-auto max-w-[860px] rounded-full px-3 py-2.5 md:px-4 md:py-3 flex items-center justify-between gap-3 transition-all duration-300 shadow-[0_16px_40px_-24px_rgba(0,0,0,.9)]"
  >
    <a href="#top" class="flex items-center gap-2.5 pl-1">
      <Logo size={30} />
      <span class="font-display font-extrabold text-[17px] tracking-tight">XYBIT</span>
    </a>

    <div class="hidden sm:flex items-center gap-6 text-[13.5px] text-ink-soft">
      <a href="#program" class="hover:text-ink transition-colors">Program</a>
      <a href="#redeem" class="hover:text-ink transition-colors">Redeem</a>
      <a href="#faq" class="hover:text-ink transition-colors">FAQ</a>
    </div>

    <a
      data-cta-redirect
      data-external="true"
      data-copy-on-click
      href={DEFAULT_SETTINGS.redirect_url}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-1.5 bg-accent text-[#0a0500] font-display font-bold text-[13px] md:text-[13.5px] px-4 py-2.5 rounded-full hover:bg-[#ff7f4a] transition-colors whitespace-nowrap"
    >
      Claim offer
      <span aria-hidden="true">→</span>
    </a>
  </nav>
</div>

<script>
  // Tighten the pill once the page starts moving — small motion, but it's
  // what makes a floating header feel attached to the scroll.
  const nav = document.getElementById("pill-nav");
  if (nav) {
    const onScroll = () => {
      const scrolled = window.scrollY > 24;
      nav.classList.toggle("max-w-[720px]", scrolled);
      nav.classList.toggle("max-w-[860px]", !scrolled);
      nav.classList.toggle("bg-[#0a0a0c]/80", scrolled);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
