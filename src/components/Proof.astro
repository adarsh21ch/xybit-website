<section id="payouts" class="py-16 md:py-20 border-t border-border">
  <div class="max-w-[1160px] mx-auto px-5 sm:px-7">
    <div class="reveal max-w-[60ch] mb-10">
      <div class="font-mono text-[11.5px] tracking-widest uppercase text-ink-faint mb-2.5">Payouts</div>
      <h2 class="text-[26px] md:text-[32px] mb-3">Proof, not promises.</h2>
      <p class="text-ink-soft text-[15px]">Swap these for real payout screenshots and trader handles from the admin dashboard before this goes live.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-4">
      {[
        { name: "R. Achebe", tier: "50K Account", quote: "First payout hit in 6 days. No back-and-forth, no questions.", amount: "$4,250" },
        { name: "M. Iyer", tier: "100K Account", quote: "Two trades a day forced me to actually wait for my setup instead of forcing it.", amount: "$9,800" },
        { name: "D. Torres", tier: "25K Account", quote: "Passed on my second attempt. The rules are strict but they're not hidden anywhere.", amount: "$2,120" },
      ].map((t) => (
        <div class="reveal bg-surface border border-border rounded-2xl p-5">
          <div class="flex items-center gap-2.5 mb-3.5">
            <span class="w-[34px] h-[34px] rounded-full border border-dashed border-ink-faint/60 flex items-center justify-center text-[9px] font-mono text-ink-faint flex-none">img</span>
            <div>
              <div class="font-bold text-sm">{t.name}</div>
              <div class="text-ink-faint text-[13px]">{t.tier}</div>
            </div>
          </div>
          <p class="text-[14px] mb-4 leading-snug">"{t.quote}"</p>
          <div class="border-t border-border pt-3.5 flex justify-between items-baseline">
            <div>
              <div class="font-mono font-bold text-[22px] text-accent">{t.amount}</div>
              <div class="text-[11px] text-ink-faint uppercase tracking-wide">Payout</div>
            </div>
            <span class="font-mono text-[9px] uppercase text-accent-dim bg-accent-bg border border-accent/30 rounded px-1.5 py-0.5">placeholder</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
