---
import { DEFAULT_SETTINGS } from "../lib/settings";
import CouponCode from "./CouponCode.astro";
---

<section class="relative py-20 md:py-32 border-t border-border overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="aurora absolute bottom-[-45%] left-1/2 -translate-x-1/2 w-[760px] h-[560px] rounded-full bg-accent/22 blur-[150px]"></div>
    <div class="aurora absolute bottom-[-20%] left-[12%] w-[380px] h-[380px] rounded-full bg-violet/18 blur-[140px]" style="animation-duration: 23s;"></div>
    <div class="dot-grid absolute inset-0 opacity-40 [mask-image:radial-gradient(ellipse_at_bottom,#000_5%,transparent_60%)]"></div>
  </div>

  <div class="max-w-[720px] mx-auto px-5 sm:px-7 text-center">
    <h2 class="reveal text-[clamp(30px,6.5vw,62px)] leading-[1.02] mb-5">
      Don't pay <span class="grad-text">full price</span>.
    </h2>
    <p id="final-sub" class="reveal text-ink-soft text-[16px] md:text-[18px] mb-10 max-w-[42ch] mx-auto leading-relaxed">
      Grab the code and apply it at checkout — it takes about ten seconds.
    </p>

    <div class="reveal max-w-[500px] mx-auto">
      <CouponCode />
      <a
        data-cta-redirect
        data-external="true"
        data-copy-on-click
        href={DEFAULT_SETTINGS.redirect_url}
        target="_blank"
        rel="noopener"
        class="cta-glow group mt-3.5 w-full inline-flex items-center justify-center gap-2 bg-gradient-to-b from-[#ff8a4c] to-accent text-[#0a0500] font-display font-bold text-[16px] md:text-[17px] px-6 py-[18px] rounded-2xl hover:-translate-y-0.5 hover:shadow-[0_18px_44px_-16px_rgba(255,106,46,.85)] transition-all"
      >
        Claim offer on xybitfunds.com
        <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
      <p id="final-expiry" class="mt-4 font-mono text-[12px] text-ink-faint"></p>
    </div>
  </div>
</section>

<script>
  import { getSettings } from "../lib/settings-client";

  getSettings().then((s) => {
    const sub = document.getElementById("final-sub");
    if (sub) sub.textContent = `Grab the code and apply it at checkout — ${s.discount_percent}% comes straight off the total.`;

    const expiry = document.getElementById("final-expiry");
    if (expiry && s.offer_end_date) expiry.textContent = `Offer ends ${s.offer_end_date}`;
  });
</script>
