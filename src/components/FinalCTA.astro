<section class="py-16 md:py-20 border-t border-border text-center">
  <div class="max-w-[1160px] mx-auto px-5 sm:px-7">
    <div class="reveal font-mono text-[11.5px] tracking-widest uppercase text-ink-faint mb-2.5">Launch offer</div>
    <h2 class="reveal text-[clamp(28px,5.5vw,46px)] mb-3">Get funded before the offer ends.</h2>
    <p id="final-cta-sub" class="reveal text-ink-soft text-[15px] max-w-[48ch] mx-auto mb-7">
      40% off every account size. Code applied automatically at checkout.
    </p>
    <div class="reveal">
      <a
        data-cta-redirect
        data-external="true"
        href="#accounts"
        class="inline-flex items-center gap-1.5 bg-accent text-[#0a0500] font-display font-bold text-[14.5px] px-6 py-4 rounded-lg hover:bg-[#ff7f4a] hover:-translate-y-px transition-all"
      >
        <span id="final-cta-label">Claim 40% Off →</span>
      </a>
    </div>
  </div>
</section>

<script>
  import { getSettings } from "../lib/settings-client";

  getSettings().then((s) => {
    const sub = document.getElementById("final-cta-sub");
    if (sub) sub.textContent = `${s.discount_percent}% off every account size. Code applied automatically at checkout.`;

    const label = document.getElementById("final-cta-label");
    if (label) label.textContent = `Claim ${s.discount_percent}% Off →`;
    document.querySelectorAll<HTMLAnchorElement>("[data-cta-redirect][data-external='true']").forEach((a) => {
      a.href = s.redirect_url;
    });
  });
</script>
