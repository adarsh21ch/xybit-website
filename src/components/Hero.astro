---
import { DEFAULT_SETTINGS, applyHeadline } from "../lib/settings";
import CouponCode from "./CouponCode.astro";

const headline = applyHeadline(DEFAULT_SETTINGS.headline, DEFAULT_SETTINGS.discount_percent);
---

<header id="top" class="relative pt-28 md:pt-40 pb-16 md:pb-24 overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="aurora absolute top-[-32%] left-1/2 -translate-x-1/2 w-[700px] h-[560px] rounded-full bg-accent/25 blur-[140px]"></div>
    <div class="aurora absolute top-[6%] right-[-12%] w-[420px] h-[420px] rounded-full bg-violet/20 blur-[140px]" style="animation-duration: 26s; animation-direction: alternate-reverse;"></div>
    <div class="dot-grid absolute inset-0 opacity-[0.5] [mask-image:radial-gradient(ellipse_at_top,#000_10%,transparent_65%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,transparent_25%,#060608_72%)]"></div>
  </div>

  <div class="max-w-[1280px] mx-auto px-5 sm:px-7 text-center">
    <div class="reveal inline-flex items-center gap-2.5 glass rounded-full px-4 py-2 font-mono text-[11px] tracking-[0.18em] uppercase text-accent mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
      <span id="hero-badge">{DEFAULT_SETTINGS.discount_percent}% off · limited time</span>
    </div>

    <h1
      id="hero-headline"
      class="reveal text-[clamp(40px,7.6vw,104px)] leading-[0.95] mb-6 max-w-[13ch] md:max-w-[22ch] mx-auto"
    >
      {headline}
    </h1>

    <p id="hero-sub" class="reveal text-[16.5px] md:text-[20px] text-ink-soft max-w-[56ch] mx-auto mb-10 leading-relaxed">
      {DEFAULT_SETTINGS.subheadline}
    </p>

    <div class="reveal max-w-[500px] mx-auto">
      <CouponCode />

      <a
        data-cta-redirect
        data-external="true"
        data-copy-on-click
        href={DEFAULT_SETTINGS.redirect_url}
        target="_blank"
        rel="noopener"
        class="cta-glow group mt-3.5 w-full inline-flex items-center justify-center gap-2 bg-gradient-to-b from-[#ff8a4c] to-accent text-[#0a0500] font-display font-bold text-[16px] md:text-[17px] px-6 py-[18px] rounded-2xl hover:-translate-y-0.5 hover:shadow-[0_18px_44px_-16px_rgba(255,106,46,.85)] transition-all"
      >
        Claim offer on xybitfunds.com
        <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>

      <p id="hero-expiry" class="mt-4 font-mono text-[12px] text-ink-faint"></p>
    </div>

    <a href="#program" class="reveal inline-flex flex-col items-center gap-1.5 mt-14 md:mt-20 text-ink-faint hover:text-ink-soft transition-colors">
      <span class="font-mono text-[11px] tracking-widest uppercase">What is Xybit?</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </a>
  </div>
</header>

<script>
  import { getSettings } from "../lib/settings-client";
  import { applyHeadline } from "../lib/settings";
  import { copyText } from "../lib/clipboard";

  getSettings().then((s) => {
    const headline = document.getElementById("hero-headline");
    if (headline) headline.textContent = applyHeadline(s.headline, s.discount_percent);

    const sub = document.getElementById("hero-sub");
    if (sub) sub.textContent = s.subheadline;

    const badge = document.getElementById("hero-badge");
    if (badge) badge.textContent = `${s.discount_percent}% off · limited time`;

    const expiry = document.getElementById("hero-expiry");
    if (expiry && s.offer_end_date) expiry.textContent = `Offer ends ${s.offer_end_date}`;

    document.querySelectorAll<HTMLAnchorElement>("[data-cta-redirect][data-external='true']").forEach((a) => {
      a.href = s.redirect_url;
    });

    // Put the code on the clipboard as they leave, so it's ready when the
    // checkout's discount field appears.
    document.querySelectorAll<HTMLAnchorElement>("[data-copy-on-click]").forEach((a) => {
      a.addEventListener("click", () => {
        void copyText(s.coupon_code);
      });
    });
  });
</script>
