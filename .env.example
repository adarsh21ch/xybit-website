# Copy this file to .env for local dev, and add the same two vars in
# Vercel → Project Settings → Environment Variables for production.
#
# Both of these are the PUBLIC anon key pair — they're safe to expose in
# client-side code (that's what "anon" / "public" means in Supabase) and
# safe to paste in chat. Never put the service_role key here or anywhere
# in this project — it bypasses Row Level Security entirely.

PUBLIC_SUPABASE_URL=https://nsgvcfesyihffspofxiq.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
